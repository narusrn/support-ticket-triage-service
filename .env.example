# LLM
OPENAI_API_KEY=                   # injected by grader at runtime, never committed
OPENAI_MODEL=gpt-4o-mini          # specialist model
SUPERVISOR_MODEL=gpt-4o-mini      # routing model, deliberately kept small/cheap

# agents/retriever.py's agentic RAG retriever (embeddings + vector search + grade/rewrite loop)
EMBEDDING_MODEL=text-embedding-3-small
RETRIEVER_TOP_K=2
RETRIEVER_MAX_REWRITES=1          # how many times it rewrites the query and retries before giving up

# API auth (single shared key via the X-API-Key header, not a user/account system)
API_KEY=                          # leave empty to disable auth (dev convenience); set a
                                   # real value to require every /api/v1/* request to send
                                   # X-API-Key matching it

# Persistence
DATABASE_PATH=./data/app.db

# Agent context engineering
CONTEXT_TOKEN_THRESHOLD=2000
CONTEXT_KEEP_TOKENS=800
AGENTS_CACHE_TTL_SECONDS=10800
MEMORY_DIR=./memory
MAX_STEPS=12                      # loop guard: hard cap on graph steps per run
AUTO_RESPOND_CONFIDENCE_THRESHOLD=0.75   # below this, action_decider can't choose auto_respond

# Logging / agent trace
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_FILE=app.log
TRACE_LOG_FILE=./logs/agent_trace.jsonl
RUN_LOG_FILE=./logs/runs.jsonl

ENV=development
